---
export interface Props {
  siteName?: string;
  class?: string;
}
const { siteName = 'Haru Digi', class: className = '' } = Astro.props;
---
<header class={`border-b border-border bg-surface ${className}`}>
  <div class="mx-auto flex flex-col sm:flex-row items-center justify-between px-[var(--container-padding)] max-w-[var(--container-max)] py-3 sm:py-0 sm:h-16 gap-2 sm:gap-0">
    <a href="/" class="text-xl font-bold text-primary no-underline shrink-0">{siteName}</a>
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 text-xs sm:text-sm">
      <slot />
    </nav>
  </div>
</header>
