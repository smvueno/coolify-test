---
import Container from '@harudigi/ui/Container.astro';
import Button from '@harudigi/ui/Button.astro';
import type { StrapiBlock } from '@harudigi/types';

interface Props {
  block: StrapiBlock;
}
const { block } = Astro.props;
const { heading, body, cta, variant = 'default' } = block;

const variantClass = {
  default: 'bg-primary text-white',
  bordered: 'border-2 border-primary bg-surface',
  minimal: 'bg-surface-alt',
}[variant];
---
<section class={`${variantClass}`}>
  <Container size="narrow" class="text-center py-16 md:py-20">
    <h2 class="font-heading text-3xl md:text-4xl font-bold">{heading}</h2>
    {body && <p class="mt-4 text-lg opacity-90">{body}</p>}
    {cta && (
      <div class="mt-8">
        <Button
          variant={variant === 'default' ? 'secondary' : 'primary'}
          href={cta.url}
          isExternal={cta.isExternal}
        >
          {cta.label}
        </Button>
      </div>
    )}
  </Container>
</section>
