---
import Container from '@harudigi/ui/Container.astro';
import Button from '@harudigi/ui/Button.astro';
import type { StrapiBlock } from '@harudigi/types';

interface Props {
  block: StrapiBlock;
}
const { block } = Astro.props;
const {
  headline,
  subtext,
  primaryCta,
  secondaryCta,
  alignment = 'center',
  size = 'large',
} = block;

const alignClass = {
  left: 'text-left items-start',
  center: 'text-center items-center',
  right: 'text-right items-end',
}[alignment];

const sizeClass = {
  small: 'py-8 md:py-12',
  medium: 'py-16 md:py-20',
  large: 'py-24 md:py-32',
}[size];
---
<section class={`flex flex-col justify-center ${sizeClass} ${alignClass}`}>
  <Container size="default">
    <h1 class={`font-heading font-bold tracking-tight ${size === 'large' ? 'text-4xl md:text-6xl' : size === 'medium' ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl'}`}>
      {headline}
    </h1>
    {subtext && (
      <p class="mt-4 md:mt-6 text-lg md:text-xl text-text-muted max-w-2xl mx-auto">
        {subtext}
      </p>
    )}
    {(primaryCta || secondaryCta) && (
      <div class="flex gap-4 mt-8">
        {primaryCta && (
          <Button variant="primary" href={primaryCta.url}>
            {primaryCta.label}
          </Button>
        )}
        {secondaryCta && (
          <Button variant="outline" href={secondaryCta.url}>
            {secondaryCta.label}
          </Button>
        )}
      </div>
    )}
  </Container>
</section>
