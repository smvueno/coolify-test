{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Client testimonials and reviews"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "avatar": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
