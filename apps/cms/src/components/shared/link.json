{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "description": "A link or button with label and URL"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "outline", "ghost"],
      "default": "primary"
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    }
  }
}
