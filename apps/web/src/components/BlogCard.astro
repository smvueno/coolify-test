---
import type { StrapiBlogPost } from '@harudigi/types';

interface Props {
  post: StrapiBlogPost;
}

const { post } = Astro.props;
const date = new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="group border border-border rounded-[var(--radius-lg)] bg-surface overflow-hidden hover:shadow-md transition-shadow">
  <div class="p-6">
    {post.category && (
      <a href={`/blog/category/${post.category.slug}`} class="text-xs font-semibold text-primary uppercase tracking-wider hover:underline">
        {post.category.name}
      </a>
    )}
    <h3 class="mt-2 font-heading font-bold text-xl leading-snug">
      <a href={`/blog/${post.slug}`} class="text-text hover:text-primary no-underline transition-colors">
        {post.title}
      </a>
    </h3>
    {post.excerpt && (
      <p class="mt-2 text-text-muted text-sm leading-relaxed line-clamp-2">{post.excerpt}</p>
    )}
    <div class="mt-4 flex items-center gap-3 text-xs text-text-muted">
      {post.author && <span>{post.author.name}</span>}
      <span>&middot;</span>
      <time datetime={post.publishedAt}>{date}</time>
      {post.tags && post.tags.length > 0 && (
        <>
          <span>&middot;</span>
          <div class="flex gap-1.5 flex-wrap">
            {post.tags.slice(0, 3).map(tag => (
              <a href={`/blog/tag/${tag.slug}`} class="bg-surface-alt px-2 py-0.5 rounded-full hover:bg-border transition-colors no-underline text-text-muted">
                #{tag.name}
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
</article>
