---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '@harudigi/ui/Container.astro';
import { getGalleries, getSite } from '../lib/strapi';

const site = await getSite();
const galleries = await getGalleries();
---

<BaseLayout title="Gallery" site={site}>
  <section class="py-12 md:py-16">
    <Container>
      <div class="text-center mb-12">
        <h1 class="font-heading text-4xl font-bold">Gallery</h1>
        <p class="mt-3 text-text-muted text-lg max-w-2xl mx-auto">
          Browse our work — websites, dashboards, and more.
        </p>
        <p class="mt-1 text-sm text-text-muted">
          <em>Upload images in Strapi admin to populate galleries.</em>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {galleries.length > 0 ? galleries.map(g => (
          <article class="bg-surface border border-border rounded-[var(--radius-lg)] overflow-hidden">
            <div class="aspect-video bg-surface-alt flex items-center justify-center text-text-muted text-sm">
              {g.images && g.images.length > 0 ? (
                <img src={g.images[0]?.url || ''} alt={g.title} class="w-full h-full object-cover" />
              ) : (
                <div class="text-center p-6">
                  <svg class="w-10 h-10 mx-auto mb-2 text-border" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>No images yet</span>
                </div>
              )}
            </div>
            <div class="p-4">
              <h2 class="font-heading font-bold text-text">{g.title}</h2>
              {g.description && <p class="text-sm text-text-muted mt-1">{g.description}</p>}
              {g.images && g.images.length > 1 && (
                <p class="text-xs text-text-muted mt-2">{g.images.length} images</p>
              )}
            </div>
          </article>
        )) : (
          <div class="col-span-full text-center py-16 text-text-muted">
            <p>No galleries yet. Add them in Strapi admin.</p>
          </div>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>
