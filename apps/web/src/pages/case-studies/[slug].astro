---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '@harudigi/ui/Container.astro';
import { getCaseStudy, getAllCaseStudySlugs, getSite } from '../../lib/strapi';

export async function getStaticPaths() {
  const slugs = await getAllCaseStudySlugs();
  return slugs.map(s => ({ params: { slug: s } }));
}

const { slug } = Astro.params;
const [site, study] = await Promise.all([getSite(), getCaseStudy(slug!)]);

if (!study) return Astro.redirect('/404');

function renderHtml(content: string | null): string {
  if (!content) return '';
  try {
    const p = JSON.parse(content);
    return p.children?.map((n: any) => {
      if (n.type === 'paragraph') return `<p class="mb-4 leading-relaxed">${n.children?.map((c: any) => c.text || '').join('')}</p>`;
      return '';
    }).join('') || '';
  } catch { return content; }
}
---

<BaseLayout title={`${study.title} | Case Studies`} site={site}>
  <section class="py-12 md:py-16">
    <Container size="narrow">
      <a href="/case-studies" class="text-sm text-primary hover:underline no-underline">&larr; All Case Studies</a>

      <div class="mt-6">
        {study.industry && <span class="text-xs font-semibold text-primary uppercase tracking-wider">{study.industry}</span>}
        <h1 class="font-heading text-3xl md:text-4xl font-bold mt-1">{study.title}</h1>
        <p class="text-text-muted mt-1">Client: <strong>{study.client}</strong></p>
      </div>

      <!-- Challenge -->
      {study.challenge && (
        <div class="mt-10">
          <h2 class="font-heading text-2xl font-bold mb-3">The Challenge</h2>
          <div class="text-text-muted leading-relaxed" set:html={renderHtml(study.challenge)}></div>
        </div>
      )}

      <!-- Solution -->
      {study.solution && (
        <div class="mt-10">
          <h2 class="font-heading text-2xl font-bold mb-3">Our Solution</h2>
          <div class="text-text-muted leading-relaxed" set:html={renderHtml(study.solution)}></div>
        </div>
      )}

      <!-- Results -->
      {study.results && (
        <div class="mt-10">
          <h2 class="font-heading text-2xl font-bold mb-3">Results</h2>
          <div class="bg-green-50 dark:bg-green-950/20 border border-green-200 dark:border-green-900 rounded-[var(--radius-lg)] p-6 text-text-muted leading-relaxed" set:html={renderHtml(study.results)}></div>
        </div>
      )}

      <!-- Related services -->
      {study.services && study.services.length > 0 && (
        <div class="mt-12 pt-8 border-t border-border">
          <h3 class="font-heading text-lg font-bold mb-3">Services Used</h3>
          <div class="flex gap-2 flex-wrap">
            {study.services.map((s: any) => (
              <a href={`/services/${s.slug || ''}`} class="bg-surface-alt text-text-muted px-3 py-1 rounded-full text-xs no-underline hover:bg-border transition-colors">
                {s.title || 'Service'}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Testimonial -->
      {study.testimonial && (
        <div class="mt-8 p-6 bg-surface-alt border border-border rounded-[var(--radius-lg)]">
          <p class="text-sm text-text-muted italic">&ldquo;{(() => { try { const p = JSON.parse(study.testimonial.content); return p.children?.[0]?.children?.map((c: any) => c.text).join(''); } catch { return ''; } })()}&rdquo;</p>
          <p class="mt-2 text-sm font-semibold text-text">{study.testimonial.name}</p>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-12 p-6 bg-primary/5 border border-primary/20 rounded-[var(--radius-lg)]">
        <h3 class="font-heading text-xl font-bold">Want similar results?</h3>
        <p class="mt-2 text-text-muted text-sm">Contact us to discuss how we can help your business.</p>
        <a href="/contact" class="mt-4 inline-block px-6 py-2.5 bg-primary text-white rounded-[var(--radius-md)] text-sm font-semibold no-underline hover:opacity-90 transition-opacity">
          Get in Touch
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>