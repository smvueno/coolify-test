---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '@harudigi/ui/Container.astro';
import { getTestimonials, getSite } from '../lib/strapi';
import type { StrapiTestimonial } from '@harudigi/types';

const site = await getSite();
const testimonials = await getTestimonials();

function renderTestimonialText(content: string): string {
  try {
    const parsed = JSON.parse(content);
    return parsed.children?.map((n: any) => {
      if (n.type === 'paragraph') return n.children?.map((c: any) => c.text || '').join('') || '';
      return '';
    }).join(' ') || '';
  } catch {
    return content;
  }
}
const headlineSize = (level: number) => {
  switch (level) {
    case 1: return 'text-3xl md:text-4xl font-bold mt-10 mb-4';
    case 2: return 'text-2xl md:text-3xl font-bold mt-8 mb-3';
    case 3: return 'text-xl md:text-2xl font-semibold mt-6 mb-2';
    default: return 'text-lg font-semibold mt-4 mb-2';
  }
};
---

<BaseLayout title="Testimonials" site={site}>
  <section class="py-12 md:py-16">
    <Container>
      <div class="text-center mb-12">
        <h1 class="font-heading text-4xl font-bold">What Our Clients Say</h1>
        <p class="mt-3 text-text-muted text-lg max-w-2xl mx-auto">
          Real feedback from businesses we've worked with.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {testimonials.map(t => (
          <article class="bg-surface border border-border rounded-[var(--radius-lg)] p-6 flex flex-col">
            <div class="flex items-center gap-1 mb-4">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg key={i} class={`w-4 h-4 ${i < (t.rating || 0) ? 'text-yellow-400' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-text leading-relaxed flex-1">&ldquo;{renderTestimonialText(t.content)}&rdquo;</p>
            <div class="mt-4 pt-4 border-t border-border">
              <p class="font-semibold text-text">{t.name}</p>
              {(t.role || t.company) && (
                <p class="text-sm text-text-muted">{[t.role, t.company].filter(Boolean).join(', ')}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .prose-content a { color: var(--color-primary); text-decoration: underline; }
  .prose-content a:hover { color: var(--color-primary-hover); }
  .prose-content code { background: var(--color-surface-alt); padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875em; }
  .prose-content pre code { background: none; padding: 0; }
</style>