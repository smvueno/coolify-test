---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '@harudigi/ui/Container.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { getPage, getSite, getTestimonials, getServices } from '../lib/strapi';

const [site, page, testimonials, services] = await Promise.all([
  getSite(),
  getPage('home'),
  getTestimonials(true),
  getServices(),
]);

const siteName = site?.siteName || 'Haru Digi Demo';
const featuredTestimonials = testimonials.slice(0, 3);
const featuredServices = services.slice(0, 3);

function renderTestimonialText(content: string): string {
  try {
    const parsed = JSON.parse(content);
    return parsed.children?.map((n: any) => {
      if (n.type === 'paragraph') return n.children?.map((c: any) => c.text || '').join('') || '';
      return '';
    }).join(' ') || '';
  } catch {
    return content;
  }
}
---

<BaseLayout title="Home" site={site}>
  {page?.blocks && <BlockRenderer blocks={page.blocks} />}

  <!-- Featured Testimonials -->
  {featuredTestimonials.length > 0 && (
    <section class="py-12 md:py-16 bg-surface-alt">
      <Container>
        <div class="text-center mb-10">
          <h2 class="font-heading text-3xl font-bold">What Our Clients Say</h2>
          <p class="mt-2 text-text-muted">Trusted by businesses worldwide</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {featuredTestimonials.map(t => (
            <article class="bg-surface border border-border rounded-[var(--radius-lg)] p-6 flex flex-col">
              <div class="flex items-center gap-1 mb-3">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg key={i} class={`w-3.5 h-3.5 ${i < (t.rating || 0) ? 'text-yellow-400' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-text text-sm leading-relaxed flex-1">&ldquo;{renderTestimonialText(t.content)}&rdquo;</p>
              <div class="mt-3 pt-3 border-t border-border">
                <p class="font-semibold text-sm text-text">{t.name}</p>
                {(t.role || t.company) && (
                  <p class="text-xs text-text-muted">{[t.role, t.company].filter(Boolean).join(', ')}</p>
                )}
              </div>
            </article>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/testimonials" class="text-sm font-semibold text-primary hover:underline no-underline">View all testimonials &rarr;</a>
        </div>
      </Container>
    </section>
  )}

  <!-- Featured Services -->
  {featuredServices.length > 0 && (
    <section class="py-12 md:py-16">
      <Container>
        <div class="text-center mb-10">
          <h2 class="font-heading text-3xl font-bold">Our Services</h2>
          <p class="mt-2 text-text-muted">Everything you need to grow your business</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {featuredServices.map(s => (
            <article class="bg-surface border border-border rounded-[var(--radius-lg)] p-6 flex flex-col hover:shadow-md transition-shadow">
              <h3 class="font-heading text-lg font-bold text-text">{s.title}</h3>
              <p class="mt-2 text-text-muted text-sm leading-relaxed flex-1">{s.description}</p>
              <div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
                {s.price && <span class="text-sm font-semibold text-primary">{s.price}</span>}
                <a href={`/services/${s.slug}`} class="text-sm font-semibold text-primary hover:underline no-underline">Learn more &rarr;</a>
              </div>
            </article>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/services" class="text-sm font-semibold text-primary hover:underline no-underline">View all services &rarr;</a>
        </div>
      </Container>
    </section>
  )}
</BaseLayout>