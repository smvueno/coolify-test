---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '@harudigi/ui/Container.astro';
import { getService, getServices, getSite } from '../../lib/strapi';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map(s => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const [site, service] = await Promise.all([
  getSite(),
  getService(slug!),
]);

if (!service) return Astro.redirect('/404');

function parseFeatures(features: string | null): string[] {
  if (!features) return [];
  try { return JSON.parse(features); } catch { return []; }
}

const features = parseFeatures(service.features);

const iconMap: Record<string, string> = {
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  zap: 'M13 10V3L4 14h7v7l9-11h-7z',
  brain: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  users: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z',
};
---

<BaseLayout title={`${service.title} | Services`} site={site}>
  <section class="py-12 md:py-16">
    <Container size="narrow">
      <a href="/services" class="text-sm text-primary hover:underline no-underline">&larr; All Services</a>
      
      <div class="mt-6 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconMap[service.icon || ''] || iconMap.code} />
          </svg>
        </div>
        <div>
          <h1 class="font-heading text-3xl md:text-4xl font-bold">{service.title}</h1>
          {service.price && <p class="text-lg font-semibold text-primary mt-1">{service.price}</p>}
        </div>
      </div>

      <p class="mt-8 text-text-muted leading-relaxed text-lg">{service.description}</p>

      {features.length > 0 && (
        <div class="mt-10">
          <h2 class="font-heading text-2xl font-bold mb-4">What's Included</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {features.map(f => (
              <li class="flex items-center gap-2 text-text bg-surface border border-border rounded-[var(--radius-lg)] p-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-12 p-6 bg-primary/5 border border-primary/20 rounded-[var(--radius-lg)]">
        <h3 class="font-heading text-xl font-bold">Interested in this service?</h3>
        <p class="mt-2 text-text-muted text-sm">Contact us to discuss your project requirements and get a custom quote.</p>
        {site?.contactEmail && (
          <a href={`mailto:${site.contactEmail}`} class="mt-4 inline-block px-6 py-2.5 bg-primary text-white rounded-[var(--radius-md)] text-sm font-semibold no-underline hover:opacity-90 transition-opacity">
            Get in Touch
          </a>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>